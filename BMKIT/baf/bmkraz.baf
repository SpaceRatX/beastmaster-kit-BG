// Razorback ID script: each cast of BMKRAZ sets BMKRZ=0; new razorbacks claim/adopt an ID,
// any razorback whose ID no longer matches BMKRZ removes itself.

IF
  Global("BMK_ME","LOCALS",1)
  !Global("BMKRZ","GLOBAL",1)
THEN
  RESPONSE #100
    CreateVisualEffectObject("SPWOOD",Myself)
    DestroySelf()
END

